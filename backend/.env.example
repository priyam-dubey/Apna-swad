# backend/.env
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your real values.
# NEVER commit this file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=4000

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apna-swad?retryWrites=true&w=majority

# JWT — use a long, random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# bcrypt salt rounds (10–12 is standard)
SALT=10

# Stripe secret key (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Frontend origin for Stripe success/cancel redirects
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
